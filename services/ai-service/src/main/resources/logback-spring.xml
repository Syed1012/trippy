<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="ai-service"/>

    <!-- Colored, concise console output matching the other Trippy services,
         with the correlation id kept for request tracing. -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [${appName}] %cyan(%logger{20}) [corr=%X{correlationId:-none}] — %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Keep the app at INFO but quiet the noisy framework loggers. -->
    <logger name="pse.trippy.aiservice" level="INFO"/>
    <logger name="org.hibernate" level="ERROR"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.springframework.boot" level="INFO"/>
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.springframework.data" level="WARN"/>
    <logger name="org.springframework.orm" level="WARN"/>
    <logger name="org.springframework.amqp" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
